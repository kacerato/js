<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SwipeRefreshLayout wrapper -->
        <android.widget.FrameLayout
            android:id="@+id/swipeRefreshContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F0F1A" />

        </android.widget.FrameLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:progressTint="#4F46E5"
            android:progressBackgroundTint="#33FFFFFF" />

        <!-- Premium Network Error Layout -->
        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="40dp"
            android:background="#222222">

            <!-- Error Icon Circle -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/error_circle">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="\uD83D\uDCE1"
                    android:textSize="48sp"
                    android:gravity="center" />
                    
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Lost"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unable to connect. Please check your internet connection and try again."
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

            <!-- Premium Retry Button -->
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:text="Try Again"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_retry"
                android:elevation="4dp" />

            <!-- Pull down hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u2193 Pull down to refresh"
                android:textSize="12sp"
                android:textColor="#4DFFFFFF"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </FrameLayout>



</LinearLayout>

