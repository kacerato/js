u0008J\u0010G\u001a\u0004\u0008K\u0010\u0004R\u0017\u0010O\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008M\u0010G\u001a\u0004\u0008N\u0010\u0004R\u0017\u0010R\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008P\u0010G\u001a\u0004\u0008Q\u0010\u0004R\u0017\u0010U\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008S\u0010G\u001a\u0004\u0008T\u0010\u0004R\u0017\u0010X\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008V\u0010G\u001a\u0004\u0008W\u0010\u0004R\u0017\u0010[\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008Y\u0010G\u001a\u0004\u0008Z\u0010\u0004R\u0017\u0010^\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008\\\u0010G\u001a\u0004\u0008]\u0010\u0004R\u0017\u0010a\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008_\u0010G\u001a\u0004\u0008`\u0010\u0004R\u0017\u0010d\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008b\u0010G\u001a\u0004\u0008c\u0010\u0004R\u0017\u0010g\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008e\u0010G\u001a\u0004\u0008f\u0010\u0004R\u0017\u0010j\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008h\u0010G\u001a\u0004\u0008i\u0010\u0004R\u001d\u0010n\u001a\u0008\u0012\u0004\u0012\u00020\u00020\u00108\u0006\u00a2\u0006\u000c\n\u0004\u0008k\u0010l\u001a\u0004\u0008m\u0010\u0012R\u0017\u0010q\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008o\u0010G\u001a\u0004\u0008p\u0010\u0004R\u0017\u0010t\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008r\u0010G\u001a\u0004\u0008s\u0010\u0004R\u0017\u0010w\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008u\u0010G\u001a\u0004\u0008v\u0010\u0004R\u0017\u0010z\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008x\u0010G\u001a\u0004\u0008y\u0010\u0004R\u0017\u0010}\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008{\u0010G\u001a\u0004\u0008|\u0010\u0004R\u0018\u0010\u0080\u0001\u001a\u00020\u00028\u0006\u00a2\u0006\u000c\n\u0004\u0008~\u0010G\u001a\u0004\u0008\u007f\u0010\u0004R\u001a\u0010\u0083\u