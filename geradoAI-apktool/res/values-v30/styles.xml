<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebToApk.Splash" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splash_window_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <style name="Theme.WebToApk.Template" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_window_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <style name="Theme.WebToApk.Template.Fullscreen" parent="@style/Theme.WebToApk.Template">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
